# Server Port (assigned automatically by platforms like Render, Heroku, Railway)
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mayleki?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Deployed Frontend URLs (for CORS and cookies)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Business Info
BUSINESS_NAME=Mayleki Imitation Jewellery
BUSINESS_PHONE=+919876543210
BUSINESS_EMAIL=hello@mayleki.com

# Optional Email / SMS / Gemini Credentials
EMAIL_USER=hello@mayleki.com
EMAIL_PASS=your_email_password
MSG91_AUTH_KEY=your_msg91_key
GEMINI_API_KEY=your_gemini_api_key
